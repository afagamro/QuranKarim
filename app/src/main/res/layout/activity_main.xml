<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale"
    android:keepScreenOn="true">

    <!-- المحتوى الرئيسي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/colorBackground">

        <!-- >>> حل مشكلة ارتفاع الشريط: نضيف fitsSystemWindows هنا فقط <<< -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/topBarBg"
            android:elevation="0dp"
            android:fitsSystemWindows="true"
            android:stateListAnimator="@null">

            <!-- Toolbar -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/topBarBg"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                app:navigationIconTint="@android:color/black"
                app:titleTextColor="@color/toolbar_title"
                app:contentInsetStartWithNavigation="0dp"/>

            <!-- Tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/topTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/topBarBg"
                app:tabIndicatorColor="@color/tabIndicatorStrong"
                app:tabSelectedTextColor="@color/tab_text_selected"
                app:tabTextColor="@color/tab_text_color"/>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- المحتوى -->
        <FrameLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/colorBackground"/>
    </LinearLayout>

    <!-- القائمة الجانبية -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/drawerBackground"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu"/>
</androidx.drawerlayout.widget.DrawerLayout>
