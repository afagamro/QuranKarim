<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- في الوضع الأفقي نسمح بالتمرير العمودي -->
    <ScrollView
        android:id="@+id/pageScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- صورة المصحف (Zoom & Pan) -->
            <com.github.chrisbanes.photoview.PhotoView
                android:id="@+id/pageImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter" />

            <!-- طبقة تظليل الآيات -->
            <com.hag.al_quran.utils.AyahHighlightView
                android:id="@+id/ayahOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />

        </FrameLayout>
    </ScrollView>

    <!-- اللودر الخاص بكل صفحة -->
    <ProgressBar
        android:id="@+id/pageLoadingView"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
